<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — OSINT Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <style>
    :root {
      --bg:      #050810;
      --surface: #090e1c;
      --panel:   #0d1426;
      --border:  rgba(255,255,255,0.06);
      --cyan:    #22d3ee;
      --indigo:  #818cf8;
      --emerald: #34d399;
      --amber:   #fbbf24;
      --red:     #f87171;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #e2e8f0;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }

    /* ── GLASS ── */
    .glass {
      background: rgba(13, 20, 38, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border);
    }

    /* ── GLOW CARDS ── */
    .glow-cyan  { box-shadow: 0 0 40px rgba(34,211,238,0.07), inset 0 1px 0 rgba(34,211,238,0.1); }
    .glow-indigo{ box-shadow: 0 0 40px rgba(129,140,248,0.07), inset 0 1px 0 rgba(129,140,248,0.1); }
    .glow-emerald{box-shadow: 0 0 40px rgba(52,211,153,0.07), inset 0 1px 0 rgba(52,211,153,0.1); }
    .glow-amber { box-shadow: 0 0 40px rgba(251,191,36,0.07),  inset 0 1px 0 rgba(251,191,36,0.1); }

    /* ── GRADIENT BORDER ── */
    .grad-border {
      position: relative;
    }
    .grad-border::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(34,211,238,0.3) 0%, rgba(129,140,248,0.15) 50%, rgba(34,211,238,0.05) 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* ── SCANLINE HEADER ── */
    .scanline {
      position: relative;
      overflow: hidden;
    }
    .scanline::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(34,211,238,0.012) 2px,
        rgba(34,211,238,0.012) 4px
      );
      pointer-events: none;
    }

    /* ── NAV ── */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      height: 56px;
      background: rgba(5,8,16,0.92);
      backdrop-filter: blur(24px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 0;
    }
    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-right: auto;
    }
    .nav-logo-icon {
      width: 30px; height: 30px;
      border-radius: 8px;
      background: linear-gradient(135deg, #22d3ee, #818cf8);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; color: #fff;
      box-shadow: 0 0 20px rgba(34,211,238,0.3);
    }
    .nav-logo-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #f1f5f9;
    }
    .nav-logo-text span { color: var(--cyan); }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 2px;
      margin-right: 20px;
    }
    .nav-link {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 500;
      color: #64748b;
      text-decoration: none;
      transition: all 0.15s;
    }
    .nav-link:hover { color: #94a3b8; background: rgba(255,255,255,0.04); }
    .nav-link.active { color: var(--cyan); background: rgba(34,211,238,0.08); }
    .nav-link i { font-size: 11px; }
    .nav-user {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px 5px 8px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
    }
    .nav-avatar {
      width: 24px; height: 24px;
      border-radius: 6px;
      background: linear-gradient(135deg, #818cf8, #22d3ee);
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 700; color: #fff;
    }
    .nav-username { font-size: 12px; font-weight: 600; color: #cbd5e1; font-family: 'JetBrains Mono', monospace; }
    .nav-logout { margin-left: 12px; color: #475569; font-size: 12px; text-decoration: none; transition: color 0.15s; }
    .nav-logout:hover { color: var(--red); }

    /* ── MAIN ── */
    .main { padding: 80px 28px 40px; max-width: 1440px; margin: 0 auto; }

    /* ── PAGE HEADER ── */
    .page-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 28px;
    }
    .page-title { font-size: 22px; font-weight: 800; color: #f1f5f9; letter-spacing: -0.03em; }
    .page-sub { font-size: 12px; color: #475569; margin-top: 3px; font-family: 'JetBrains Mono', monospace; }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      border-radius: 10px;
      background: linear-gradient(135deg, #22d3ee, #818cf8);
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 20px rgba(34,211,238,0.25);
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 28px rgba(34,211,238,0.35); }
    .btn-primary i { font-size: 11px; }

    /* ── STAT CARDS ── */
    .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 20px; }
    @media(max-width:900px){ .stats-grid{ grid-template-columns:repeat(2,1fr); } }
    .stat-card {
      border-radius: 16px;
      padding: 20px;
      position: relative;
      overflow: hidden;
    }
    .stat-card::after {
      content: '';
      position: absolute;
      top: -30px; right: -30px;
      width: 80px; height: 80px;
      border-radius: 50%;
      opacity: 0.06;
    }
    .stat-card.c-cyan::after  { background: var(--cyan); }
    .stat-card.c-indigo::after{ background: var(--indigo); }
    .stat-card.c-emerald::after{background: var(--emerald);}
    .stat-card.c-amber::after { background: var(--amber); }
    .stat-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #475569;
      margin-bottom: 10px;
    }
    .stat-value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 30px;
      font-weight: 700;
      line-height: 1;
      margin-bottom: 6px;
    }
    .stat-sub { font-size: 11px; color: #334155; }
    .stat-icon {
      position: absolute;
      top: 18px; right: 18px;
      width: 34px; height: 34px;
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px;
    }

    /* ── CHARTS ── */
    .charts-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 14px; margin-bottom: 20px; }
    @media(max-width:900px){ .charts-grid{ grid-template-columns:1fr; } }
    .chart-card { border-radius: 16px; padding: 22px; }
    .chart-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .chart-title { font-size: 13px; font-weight: 700; color: #f1f5f9; }
    .chart-sub { font-size: 11px; color: #475569; margin-top: 2px; }
    .chart-link { font-size: 11px; color: var(--cyan); text-decoration: none; display: flex; align-items: center; gap: 4px; opacity: 0.8; }
    .chart-link:hover { opacity: 1; }

    /* ── BANNER ── */
    .banner { border-radius: 14px; padding: 16px 20px; margin-bottom: 20px; display: flex; align-items: center; gap: 16px; }
    .banner-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); white-space: nowrap; display: flex; align-items: center; gap: 6px; }
    .banner input {
      flex: 1;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 12px;
      color: #cbd5e1;
      outline: none;
      transition: border-color 0.15s;
      font-family: 'JetBrains Mono', monospace;
    }
    .banner input:focus { border-color: rgba(251,191,36,0.4); }
    .banner-btn {
      padding: 8px 16px;
      border-radius: 8px;
      background: rgba(251,191,36,0.1);
      border: 1px solid rgba(251,191,36,0.2);
      color: var(--amber);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
      display: flex; align-items: center; gap: 6px;
      white-space: nowrap;
    }
    .banner-btn:hover { background: rgba(251,191,36,0.18); }

    /* ── TABLE CARD ── */
    .table-card { border-radius: 16px; overflow: hidden; }
    .table-head-bar {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .table-title-group { display: flex; align-items: center; gap: 10px; }
    .table-title { font-size: 14px; font-weight: 700; color: #f1f5f9; }
    .table-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      color: #475569;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      padding: 2px 8px;
      border-radius: 20px;
    }
    .search-wrap { position: relative; }
    .search-wrap i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #334155; font-size: 11px; }
    .search-wrap input {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 7px 12px 7px 30px;
      font-size: 12px;
      color: #94a3b8;
      outline: none;
      width: 220px;
      transition: border-color 0.15s;
    }
    .search-wrap input:focus { border-color: rgba(34,211,238,0.3); }
    .search-wrap input::placeholder { color: #334155; }

    /* ── TABLE ── */
    table { width: 100%; border-collapse: collapse; }
    thead tr { border-bottom: 1px solid var(--border); background: rgba(255,255,255,0.015); }
    thead th {
      padding: 11px 16px;
      font-size: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #334155;
    }
    tbody tr { border-bottom: 1px solid rgba(255,255,255,0.025); transition: background 0.12s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: rgba(255,255,255,0.018); }
    td { padding: 13px 16px; font-size: 12px; vertical-align: middle; }

    /* ── KEY BADGE ── */
    .key-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      color: var(--cyan);
      background: rgba(34,211,238,0.06);
      border: 1px solid rgba(34,211,238,0.15);
      padding: 4px 10px;
      border-radius: 6px;
      letter-spacing: 0.04em;
    }

    /* ── STATUS BADGES ── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .badge-active  { background: rgba(52,211,153,0.08); color: var(--emerald); border: 1px solid rgba(52,211,153,0.2); }
    .badge-disabled{ background: rgba(248,113,113,0.08); color: var(--red);     border: 1px solid rgba(248,113,113,0.2); }
    .badge-expired { background: rgba(251,191,36,0.08);  color: var(--amber);   border: 1px solid rgba(251,191,36,0.2); }
    .dot { width: 5px; height: 5px; border-radius: 50%; }
    .dot-active  { background: var(--emerald); box-shadow: 0 0 6px var(--emerald); animation: pulse 2s infinite; }
    .dot-disabled{ background: var(--red); }
    .dot-expired { background: var(--amber); }
    @keyframes pulse {
      0%,100% { opacity: 1; } 50% { opacity: 0.4; }
    }

    /* ── ENDPOINT BADGE ── */
    .ep-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: var(--indigo);
      background: rgba(129,140,248,0.08);
      border: 1px solid rgba(129,140,248,0.15);
      padding: 3px 9px;
      border-radius: 5px;
    }

    /* ── NOTE BADGE ── */
    .note-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      color: var(--amber);
      background: rgba(251,191,36,0.06);
      border: 1px solid rgba(251,191,36,0.15);
      padding: 2px 7px;
      border-radius: 4px;
      margin-top: 4px;
    }

    /* ── ACTION BUTTONS ── */
    .action-btn {
      width: 28px; height: 28px;
      border-radius: 7px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.03);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer;
      color: #475569;
      font-size: 11px;
      transition: all 0.15s;
    }
    .action-btn:hover.edit   { background: rgba(129,140,248,0.12); border-color: rgba(129,140,248,0.3); color: var(--indigo); }
    .action-btn:hover.delete { background: rgba(248,113,113,0.1);  border-color: rgba(248,113,113,0.3); color: var(--red); }

    /* ── MODAL ── */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 100;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow-y: auto;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: #0a0f1e;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(34,211,238,0.05);
      my: 20px;
    }
    .modal-header {
      padding: 18px 22px;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-title { font-size: 13px; font-weight: 700; color: #f1f5f9; display: flex; align-items: center; gap: 8px; }
    .modal-title i { color: var(--cyan); }
    .modal-close {
      width: 28px; height: 28px;
      border-radius: 7px;
      border: 1px solid var(--border);
      background: transparent;
      color: #475569;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px;
      transition: all 0.15s;
    }
    .modal-close:hover { background: rgba(255,255,255,0.05); color: #94a3b8; }
    .modal-body { padding: 22px; }
    .form-group { margin-bottom: 16px; }
    .form-label {
      display: block;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #475569;
      margin-bottom: 7px;
    }
    .form-input, .form-select {
      width: 100%;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 9px 14px;
      font-size: 12px;
      color: #cbd5e1;
      outline: none;
      transition: border-color 0.15s;
      font-family: 'Plus Jakarta Sans', sans-serif;
      appearance: none;
    }
    .form-input:focus, .form-select:focus { border-color: rgba(34,211,238,0.4); background: rgba(34,211,238,0.02); }
    .form-select option { background: #0d1426; }
    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-section {
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 16px;
    }
    .form-section-label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #334155;
      margin-bottom: 12px;
    }
    .toggle-row { display: flex; align-items: center; justify-content: space-between; }
    .toggle-row label:first-child { font-size: 11px; color: #64748b; font-weight: 500; }
    input[type=checkbox] { accent-color: var(--cyan); width: 14px; height: 14px; cursor: pointer; }
    .btn-modal {
      width: 100%;
      padding: 11px;
      border-radius: 11px;
      font-size: 13px;
      font-weight: 700;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 4px;
    }
    .btn-modal-primary {
      background: linear-gradient(135deg, #22d3ee, #818cf8);
      color: #fff;
      box-shadow: 0 4px 20px rgba(34,211,238,0.2);
    }
    .btn-modal-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 26px rgba(34,211,238,0.3); }
    .btn-modal-edit { background: rgba(129,140,248,0.15); color: var(--indigo); border: 1px solid rgba(129,140,248,0.25); }
    .btn-modal-edit:hover { background: rgba(129,140,248,0.22); }

    /* ── TOAST ── */
    .toast {
      position: fixed;
      bottom: 24px; right: 24px;
      z-index: 200;
      background: #0d1426;
      border: 1px solid rgba(52,211,153,0.3);
      border-radius: 12px;
      padding: 12px 18px;
      display: flex; align-items: center; gap: 10px;
      font-size: 12px;
      font-weight: 600;
      color: var(--emerald);
      box-shadow: 0 10px 40px rgba(0,0,0,0.5), 0 0 20px rgba(52,211,153,0.1);
      transform: translateY(80px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
      pointer-events: none;
    }
    .toast.show { transform: translateY(0); opacity: 1; }

    /* ── EMPTY STATE ── */
    .empty-state { text-align: center; padding: 60px 20px; color: #334155; }
    .empty-state i { font-size: 32px; margin-bottom: 12px; display: block; opacity: 0.3; }
    .empty-state p { font-size: 13px; }

    /* ── HITS DISPLAY ── */
    .hits-val { font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #f1f5f9; font-size: 13px; }
    .hits-sub { font-size: 10px; color: #334155; margin-top: 2px; }

    /* ── EXPIRY ── */
    .expiry-val { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #94a3b8; }
    .expiry-time { font-size: 10px; color: #334155; margin-top: 1px; }
    .expiry-expired { color: var(--red); text-decoration: line-through; }

    /* ── OWNER COL ── */
    .owner-name { font-weight: 600; color: #e2e8f0; font-size: 13px; }
    .owner-handle { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #334155; margin-top: 2px; }

    /* ── CUSTOM EXPIRY ── */
    .hidden { display: none !important; }

    /* SEGMENTED TOGGLE */
    .seg-toggle { display: inline-flex; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 8px; padding: 2px; gap: 2px; }
    .seg-btn { padding: 4px 11px; border-radius: 6px; border: none; background: transparent; color: #64748b; font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.15s; font-family: 'Plus Jakarta Sans', sans-serif; }
    .seg-btn:hover { color: #94a3b8; }
    .seg-btn.active { background: linear-gradient(135deg, var(--cyan), var(--indigo)); color: #fff; }

    /* ACCESS HINT */
    .access-hint { background: rgba(52,211,153,0.05); border: 1px solid rgba(52,211,153,0.15); border-radius: 10px; padding: 12px 14px; font-size: 12px; color: #94a3b8; display: flex; align-items: center; gap: 8px; }

    /* CHECKBOX GRID */
    .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; max-height: 200px; overflow-y: auto; padding: 4px; background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 10px; }
    .check-item { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 7px; cursor: pointer; transition: background 0.12s; font-size: 11px; color: #94a3b8; }
    .check-item:hover { background: rgba(255,255,255,0.03); }
    .check-item input { accent-color: var(--cyan); width: 14px; height: 14px; cursor: pointer; flex-shrink: 0; }
    .check-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ── HEALTH + ACTIVITY GRID ── */
    .health-activity-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px; }
    @media(max-width:900px){ .health-activity-grid{ grid-template-columns:1fr; } }
    .hs-card { border-radius: 16px; overflow: hidden; }
    .hs-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .hs-title { font-size: 13px; font-weight: 700; color: #f1f5f9; display: flex; align-items: center; gap: 8px; }
    .hs-live { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; color: var(--emerald); text-transform: uppercase; letter-spacing: 0.05em; }
    .hs-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--emerald); box-shadow: 0 0 6px var(--emerald); animation: pulse 2s infinite; }
    .hs-link { font-size: 11px; color: var(--cyan); text-decoration: none; display: flex; align-items: center; gap: 4px; opacity: 0.85; }
    .hs-link:hover { opacity: 1; }

    .hs-body { padding: 18px 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .hs-metric { display: flex; align-items: center; gap: 12px; }
    .hs-metric-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
    .hs-metric-label { font-size: 10px; color: #475569; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; margin-bottom: 3px; }
    .hs-metric-value { font-family: 'JetBrains Mono', monospace; font-size: 16px; font-weight: 700; color: #f1f5f9; }

    .activity-feed { padding: 6px 20px 14px; max-height: 210px; overflow-y: auto; }
    .activity-row { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .activity-row:last-child { border-bottom: none; }
    .activity-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .activity-dot.ok  { background: var(--emerald); box-shadow: 0 0 5px var(--emerald); }
    .activity-dot.err { background: var(--red); box-shadow: 0 0 5px var(--red); }
    .activity-ep { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--indigo); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .activity-code { font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 5px; }
    .activity-code.ok  { color: var(--emerald); background: rgba(52,211,153,0.1); }
    .activity-code.err { color: var(--red); background: rgba(248,113,113,0.1); }
    .activity-time { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #334155; white-space: nowrap; }
    .activity-empty { display: flex; align-items: center; gap: 8px; justify-content: center; padding: 40px 0; color: #334155; font-size: 12px; }

    /* ── API MANAGEMENT ─────────────────────────────────── */
    .api-mgmt-wrap {
      margin-top: 20px;
      background: rgba(13, 20, 38, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
    }

    .api-mgmt-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 24px 18px;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .api-mgmt-title-group { display: flex; align-items: center; gap: 14px; }
    .api-mgmt-icon {
      width: 42px; height: 42px;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(34,211,238,0.15), rgba(129,140,248,0.15));
      border: 1px solid rgba(34,211,238,0.2);
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; color: var(--cyan);
      box-shadow: 0 0 20px rgba(34,211,238,0.08);
    }
    .api-mgmt-title { font-size: 15px; font-weight: 800; color: #f1f5f9; letter-spacing: -0.02em; }
    .api-mgmt-sub { font-size: 11px; color: #475569; margin-top: 2px; font-family: 'JetBrains Mono', monospace; }

    .api-mgmt-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .api-search-wrap {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 7px 12px;
    }
    .api-search-wrap i { font-size: 11px; color: #334155; }
    .api-search-wrap input {
      background: none; border: none; outline: none;
      color: #94a3b8; font-size: 12px; width: 160px;
      font-family: 'JetBrains Mono', monospace;
    }
    .api-search-wrap input::placeholder { color: #334155; }

    .api-filter-tabs { display: flex; gap: 4px; }
    .api-filter-btn {
      display: flex; align-items: center; gap: 5px;
      padding: 6px 12px; border-radius: 8px;
      background: transparent; border: 1px solid transparent;
      color: #475569; font-size: 11px; font-weight: 600;
      cursor: pointer; transition: all 0.15s;
    }
    .api-filter-btn:hover { color: #64748b; background: rgba(255,255,255,0.03); }
    .api-filter-btn.active {
      color: var(--cyan);
      background: rgba(34,211,238,0.08);
      border-color: rgba(34,211,238,0.15);
    }
    .flt-dot { width: 7px; height: 7px; border-radius: 50%; }
    .flt-dot.on  { background: var(--emerald); box-shadow: 0 0 6px var(--emerald); }
    .flt-dot.off { background: var(--red); }

    /* Stats strip */
    .api-stats-strip {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 24px;
      border-bottom: 1px solid var(--border);
      background: rgba(0,0,0,0.15);
      flex-wrap: wrap;
    }
    .api-stat-pill {
      display: flex; align-items: center; gap: 6px;
      padding: 4px 12px; border-radius: 20px;
      font-size: 11px; font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      border: 1px solid;
    }
    .pill-emerald { color: var(--emerald); background: rgba(52,211,153,0.07); border-color: rgba(52,211,153,0.18); }
    .pill-red     { color: var(--red);     background: rgba(248,113,113,0.07); border-color: rgba(248,113,113,0.18); }
    .pill-slate   { color: #64748b;        background: rgba(255,255,255,0.03); border-color: var(--border); }

    .api-bulk-btn {
      display: flex; align-items: center; gap: 6px;
      padding: 5px 13px; border-radius: 8px;
      font-size: 11px; font-weight: 700;
      cursor: pointer; transition: all 0.15s;
      margin-left: auto;
    }
    .bulk-on {
      background: rgba(52,211,153,0.08);
      border: 1px solid rgba(52,211,153,0.2);
      color: var(--emerald);
    }
    .bulk-on:hover { background: rgba(52,211,153,0.16); }
    .bulk-off {
      background: rgba(248,113,113,0.08);
      border: 1px solid rgba(248,113,113,0.2);
      color: var(--red);
      margin-left: 0;
    }
    .bulk-off:hover { background: rgba(248,113,113,0.16); }

    /* Grid */
    .api-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
      gap: 1px;
      background: var(--border);
    }

    .api-card-item {
      background: var(--panel);
      padding: 18px;
      transition: background 0.2s;
      display: flex; flex-direction: column; gap: 8px;
    }
    .api-card-item:hover { background: rgba(15,24,44,0.95); }
    .api-card-item.is-off { opacity: 0.6; }
    .api-card-item.is-off .api-card-path { color: #1e293b; }

    .api-card-top { display: flex; align-items: flex-start; justify-content: space-between; }

    .api-card-icon-wrap {
      width: 36px; height: 36px;
      border-radius: 10px;
      background: rgba(34,211,238,0.07);
      border: 1px solid rgba(34,211,238,0.1);
      display: flex; align-items: center; justify-content: center;
      font-size: 16px;
    }
    .api-card-emoji { line-height: 1; }

    /* Toggle Switch */
    .toggle-switch { position: relative; display: inline-flex; cursor: pointer; }
    .toggle-switch input { position: absolute; opacity: 0; width: 0; height: 0; }
    .toggle-track {
      width: 38px; height: 21px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 99px;
      position: relative;
      transition: all 0.25s;
    }
    .toggle-switch input:checked + .toggle-track {
      background: rgba(34,211,238,0.2);
      border-color: rgba(34,211,238,0.4);
      box-shadow: 0 0 12px rgba(34,211,238,0.2);
    }
    .toggle-thumb {
      position: absolute;
      top: 2px; left: 2px;
      width: 15px; height: 15px;
      background: #334155;
      border-radius: 50%;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .toggle-switch input:checked + .toggle-track .toggle-thumb {
      left: 19px;
      background: var(--cyan);
      box-shadow: 0 0 8px rgba(34,211,238,0.6);
    }

    .api-card-name {
      font-size: 12px; font-weight: 700; color: #cbd5e1;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-top: 2px;
    }
    .api-card-path {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: #334155;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .api-card-foot {
      display: flex; align-items: center; justify-content: space-between;
      margin-top: 4px;
    }
    .api-status-badge {
      display: flex; align-items: center; gap: 5px;
      font-size: 10px; font-weight: 700; font-family: 'JetBrains Mono', monospace;
      padding: 3px 8px; border-radius: 99px;
    }
    .badge-live { color: var(--emerald); background: rgba(52,211,153,0.08); border: 1px solid rgba(52,211,153,0.2); }
    .badge-dead { color: #475569;        background: rgba(255,255,255,0.03); border: 1px solid var(--border); }
    .badge-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor;
    }
    .badge-live .badge-dot { box-shadow: 0 0 4px currentColor; animation: pulse-dot 2s infinite; }
    @keyframes pulse-dot {
      0%,100%{ opacity:1; } 50%{ opacity:0.4; }
    }

    .api-msg-btn {
      width: 26px; height: 26px;
      border-radius: 7px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      color: #334155;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; cursor: pointer;
      transition: all 0.15s;
    }
    .api-msg-btn:hover { color: var(--indigo); border-color: rgba(129,140,248,0.3); background: rgba(129,140,248,0.06); }

    /* Updating state */
    .api-card-item.updating { pointer-events: none; }
    .api-card-item.updating .toggle-track { opacity: 0.5; }

    /* Empty */
    .api-empty {
      padding: 48px;
      text-align: center;
      color: #334155;
    }
    .api-empty i { font-size: 28px; margin-bottom: 10px; display: block; }
    .api-empty p { font-size: 13px; }

  </style>
</head>
<body>

<!-- ── NAV ──────────────────────────────────────────── -->
<nav class="nav scanline">
  <div class="nav-logo">
    <div class="nav-logo-icon"><i class="fa-solid fa-satellite-dish"></i></div>
    <span class="nav-logo-text">OSINT<span>HUB</span></span>
  </div>
  <div class="nav-links">
    <a href="/admin/dashboard" class="nav-link active"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
    <a href="/admin/analytics" class="nav-link"><i class="fa-solid fa-chart-line"></i> Analytics</a>
    <a href="/admin/login-history" class="nav-link"><i class="fa-solid fa-clock-rotate-left"></i> Login History</a>
    <a href="/endpoints" class="nav-link"><i class="fa-solid fa-cubes"></i> Endpoints</a>
  </div>
  <div class="nav-user">
    <div class="nav-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
    <span class="nav-username"><%= user.username %></span>
  </div>
  <a href="/logout" class="nav-logout" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
</nav>

<!-- ── MAIN ──────────────────────────────────────────── -->
<main class="main">

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <div class="page-title">Command Center</div>
      <div class="page-sub">// api key management & system overview</div>
    </div>
    <button class="btn-primary" onclick="openModal('generateModal')">
      <i class="fa-solid fa-plus"></i> New Key
    </button>
  </div>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card glass grad-border glow-indigo c-indigo">
      <div class="stat-label">Total Keys</div>
      <div class="stat-value" style="color:var(--indigo)"><%= keys.length %></div>
      <div class="stat-sub">Registered</div>
      <div class="stat-icon" style="background:rgba(129,140,248,0.1);color:var(--indigo)"><i class="fa-solid fa-key"></i></div>
    </div>
    <div class="stat-card glass grad-border glow-emerald c-emerald">
      <div class="stat-label">Active</div>
      <div class="stat-value" style="color:var(--emerald)"><%= active %></div>
      <div class="stat-sub">Operational</div>
      <div class="stat-icon" style="background:rgba(52,211,153,0.1);color:var(--emerald)"><i class="fa-solid fa-shield-check"></i></div>
    </div>
    <div class="stat-card glass grad-border glow-cyan c-cyan">
      <div class="stat-label">Total Hits</div>
      <div class="stat-value" style="color:var(--cyan)"><%= totalHits.toLocaleString() %></div>
      <div class="stat-sub">All time requests</div>
      <div class="stat-icon" style="background:rgba(34,211,238,0.1);color:var(--cyan)"><i class="fa-solid fa-bolt"></i></div>
    </div>
    <div class="stat-card glass grad-border glow-amber c-amber">
      <div class="stat-label">Endpoints</div>
      <div class="stat-value" style="color:var(--amber)"><%= apis.length %></div>
      <div class="stat-sub">Active modules</div>
      <div class="stat-icon" style="background:rgba(251,191,36,0.1);color:var(--amber)"><i class="fa-solid fa-cubes"></i></div>
    </div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-card glass">
      <div class="chart-head">
        <div>
          <div class="chart-title">Request Volume</div>
          <div class="chart-sub">Last 7 days</div>
        </div>
        <a href="/admin/analytics" class="chart-link">Full view <i class="fa-solid fa-arrow-right" style="font-size:9px"></i></a>
      </div>
      <div style="height:160px"><canvas id="dailyChart"></canvas></div>
    </div>
    <div class="chart-card glass">
      <div class="chart-head">
        <div>
          <div class="chart-title">Top Endpoints</div>
          <div class="chart-sub">By usage</div>
        </div>
      </div>
      <div style="height:160px"><canvas id="endpointsChart"></canvas></div>
    </div>
  </div>

  <!-- System Health + Recent Activity -->
  <div class="health-activity-grid">
    <!-- System Health -->
    <div class="hs-card glass">
      <div class="hs-head">
        <div class="hs-title"><i class="fa-solid fa-heart-pulse" style="color:var(--emerald)"></i> System Health</div>
        <span class="hs-live"><span class="hs-dot"></span> Online</span>
      </div>
      <div class="hs-body">
        <div class="hs-metric">
          <div class="hs-metric-icon" style="background:rgba(52,211,153,0.1);color:var(--emerald)"><i class="fa-solid fa-clock"></i></div>
          <div class="hs-metric-info">
            <div class="hs-metric-label">Uptime</div>
            <div class="hs-metric-value" id="uptimeDisplay"><%= Math.floor(health.uptime/3600) %>h <%= Math.floor((health.uptime%3600)/60) %>m</div>
          </div>
        </div>
        <div class="hs-metric">
          <div class="hs-metric-icon" style="background:rgba(34,211,238,0.1);color:var(--cyan)"><i class="fa-solid fa-plug-circle-check"></i></div>
          <div class="hs-metric-info">
            <div class="hs-metric-label">Active APIs</div>
            <div class="hs-metric-value"><%= health.activeApis %> / <%= health.totalApis %></div>
          </div>
        </div>
        <div class="hs-metric">
          <div class="hs-metric-icon" style="background:rgba(129,140,248,0.1);color:var(--indigo)"><i class="fa-solid fa-circle-check"></i></div>
          <div class="hs-metric-info">
            <div class="hs-metric-label">Success Rate</div>
            <div class="hs-metric-value"><%= health.successRate %>%</div>
          </div>
        </div>
        <div class="hs-metric">
          <div class="hs-metric-icon" style="background:rgba(251,191,36,0.1);color:var(--amber)"><i class="fa-solid fa-server"></i></div>
          <div class="hs-metric-info">
            <div class="hs-metric-label">Total Served</div>
            <div class="hs-metric-value"><%= health.totalReq.toLocaleString() %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="hs-card glass">
      <div class="hs-head">
        <div class="hs-title"><i class="fa-solid fa-wave-square" style="color:var(--cyan)"></i> Live Activity</div>
        <a href="/admin/analytics" class="hs-link">View all <i class="fa-solid fa-arrow-right" style="font-size:9px"></i></a>
      </div>
      <div class="activity-feed">
        <% if(recentActivity && recentActivity.length > 0) { %>
          <% recentActivity.forEach(function(a) { %>
            <div class="activity-row">
              <span class="activity-dot <%= a.ok ? 'ok' : 'err' %>"></span>
              <span class="activity-ep"><%= a.endpoint %></span>
              <span class="activity-code <%= a.ok ? 'ok' : 'err' %>"><%= a.code %></span>
              <span class="activity-time"><%= new Date(a.time).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %></span>
            </div>
          <% }); %>
        <% } else { %>
          <div class="activity-empty"><i class="fa-solid fa-inbox"></i> No activity yet</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Maintenance Banner -->
  <form action="/admin/update-settings" method="POST">
    <div class="banner glass">
      <div class="banner-label"><i class="fa-solid fa-triangle-exclamation"></i> Banner</div>
      <input type="text" name="maintenance_message" value="<%= settings.maintenance_message %>" placeholder="Maintenance message...">
      <button type="submit" class="banner-btn"><i class="fa-solid fa-floppy-disk"></i> Save</button>
    </div>
  </form>

  <!-- Keys Table -->
  <div class="table-card glass">
    <div class="table-head-bar">
      <div class="table-title-group">
        <span class="table-title">API Keys</span>
        <span class="table-count"><%= keys.length %> total</span>
      </div>
      <div class="search-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" onkeyup="filterKeys()" placeholder="Search keys...">
      </div>
    </div>
    <div style="overflow-x:auto">
      <table id="keysTable">
        <thead>
          <tr>
            <th style="text-align:left">Client</th>
            <th style="text-align:left">Key</th>
            <th style="text-align:left">Access</th>
            <th style="text-align:left">Hits</th>
            <th style="text-align:left">Expires</th>
            <th style="text-align:left">Status</th>
            <th style="text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(keys && keys.length > 0) { %>
            <% keys.forEach(function(key) {
              var allowed = 'All APIs';
              try { var p=JSON.parse(key.allowed_apis); if(Array.isArray(p)&&!p.includes('all')) allowed=p.join(', '); } catch(e){}
              var exp = key.expires_at ? new Date(key.expires_at) : null;
              var isExpired = exp && exp < new Date();
            %>
            <tr>
              <td>
                <div class="owner-name"><%= key.name || 'Unnamed' %></div>
                <div class="owner-handle"><%= key.owner_username || owner %></div>
                <% if(key.note_enabled && key.key_note) { %>
                  <span class="note-badge"><i class="fa-solid fa-note-sticky" style="font-size:9px"></i><%= key.key_note %></span>
                <% } %>
              </td>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <span class="key-badge"><%= key.key %></span>
                  <button onclick="copyKey('<%= key.key %>')" class="action-btn" style="border:none" title="Copy"><i class="fa-regular fa-copy"></i></button>
                </div>
              </td>
              <td><span class="ep-badge"><%= allowed %></span></td>
              <td>
                <div class="hits-val"><%= key.hits.toLocaleString() %></div>
                <div class="hits-sub">
                  <% if(key.unlimited_hits){ %><span style="color:var(--emerald);font-family:'JetBrains Mono',monospace;font-size:10px"><i class="fa-solid fa-infinity"></i> unlimited</span>
                  <%} else if(key.rate_limit_enabled){ %><%= key.rate_limit_per_day %>/day<%} else {%>standard<%}%>
                </div>
              </td>
              <td>
                <% if(!exp){ %><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#334155">never</span>
                <%} else {%>
                  <div class="expiry-val <%=isExpired?'expiry-expired':''%>"><%= exp.toLocaleDateString() %></div>
                  <div class="expiry-time"><%= exp.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %></div>
                <%}%>
              </td>
              <td>
                <%if(key.api_enabled===0){%>
                  <span class="badge badge-disabled"><span class="dot dot-disabled"></span>Off</span>
                <%}else if(isExpired){%>
                  <span class="badge badge-expired"><span class="dot dot-expired"></span>Expired</span>
                <%}else if(key.status==='active'){%>
                  <span class="badge badge-active"><span class="dot dot-active"></span>Live</span>
                <%}else{%>
                  <span class="badge badge-expired"><span class="dot dot-expired"></span><%= key.status %></span>
                <%}%>
              </td>
              <td style="text-align:right">
                <div style="display:flex;align-items:center;justify-content:flex-end;gap:6px">
                  <button
                    onclick="openEditModal(this)"
                    data-id="<%= key.id %>"
                    data-name="<%= encodeURIComponent(key.name||'') %>"
                    data-enabled="<%= key.api_enabled %>"
                    data-unlimited="<%= key.unlimited_hits %>"
                    data-allowed="<%= encodeURIComponent(key.allowed_apis||'') %>"
                    data-rl-day="<%= key.rate_limit_per_day %>"
                    data-rl-min="<%= key.rate_limit_per_minute %>"
                    data-note="<%= encodeURIComponent(key.key_note||'') %>"
                    class="action-btn edit" title="Edit">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <form action="/admin/delete-key" method="POST" style="display:inline" onsubmit="return confirm('Delete permanently?')">
                    <input type="hidden" name="id" value="<%= key.id %>">
                    <button type="submit" class="action-btn delete" title="Delete"><i class="fa-solid fa-trash-can"></i></button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="7">
              <div class="empty-state">
                <i class="fa-solid fa-key"></i>
                <p>No keys yet. Generate your first one.</p>
              </div>
            </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ── API MANAGEMENT ──────────────────────────────── -->
  <div class="api-mgmt-wrap">

    <!-- Header row -->
    <div class="api-mgmt-header">
      <div class="api-mgmt-title-group">
        <div class="api-mgmt-icon"><i class="fa-solid fa-cubes-stacked"></i></div>
        <div>
          <div class="api-mgmt-title">Endpoint Control</div>
          <div class="api-mgmt-sub">Toggle live availability of every module</div>
        </div>
      </div>
      <div class="api-mgmt-controls">
        <div class="api-search-wrap">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="apiSearchInput" onkeyup="filterApis()" placeholder="Search endpoints...">
        </div>
        <div class="api-filter-tabs" id="apiFilterTabs">
          <button class="api-filter-btn active" onclick="filterByStatus('all',this)">All</button>
          <button class="api-filter-btn" onclick="filterByStatus('on',this)"><span class="flt-dot on"></span>Online</button>
          <button class="api-filter-btn" onclick="filterByStatus('off',this)"><span class="flt-dot off"></span>Offline</button>
        </div>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="api-stats-strip">
      <div class="api-stat-pill pill-emerald">
        <i class="fa-solid fa-circle-check"></i>
        <span id="apiOnlineCount"><%= apis.filter(function(a){return a.is_active===1;}).length %></span> online
      </div>
      <div class="api-stat-pill pill-red">
        <i class="fa-solid fa-circle-xmark"></i>
        <span id="apiOfflineCount"><%= apis.filter(function(a){return a.is_active===0;}).length %></span> offline
      </div>
      <div class="api-stat-pill pill-slate">
        <i class="fa-solid fa-layer-group"></i>
        <%= apis.length %> total
      </div>
      <button class="api-bulk-btn bulk-on" onclick="bulkToggle(true)">
        <i class="fa-solid fa-power-off"></i> Enable All
      </button>
      <button class="api-bulk-btn bulk-off" onclick="bulkToggle(false)">
        <i class="fa-solid fa-ban"></i> Disable All
      </button>
    </div>

    <!-- API Grid -->
    <div class="api-grid" id="apiGrid">
      <% apis.forEach(function(api) { %>
      <div class="api-card-item <%= api.is_active ? 'is-on' : 'is-off' %>"
           data-name="<%= api.display_name.toLowerCase() %>"
           data-status="<%= api.is_active ? 'on' : 'off' %>"
           data-id="<%= api.id %>"
           id="apicard-<%= api.id %>">

        <div class="api-card-top">
          <div class="api-card-icon-wrap">
            <span class="api-card-emoji"><%= api.display_name.split(' ')[0] %></span>
          </div>
          <label class="toggle-switch" title="Toggle <%= api.display_name %>">
            <input type="checkbox"
              <%= api.is_active ? 'checked' : '' %>
              onchange="toggleApi(<%= api.id %>, this.checked, '<%= api.name %>')"
              id="toggle-<%= api.id %>">
            <span class="toggle-track">
              <span class="toggle-thumb"></span>
            </span>
          </label>
        </div>

        <div class="api-card-name"><%= api.display_name.replace(/^\S+\s/, '') %></div>
        <div class="api-card-path"><%= api.endpoint %></div>

        <div class="api-card-foot">
          <span class="api-status-badge <%= api.is_active ? 'badge-live' : 'badge-dead' %>">
            <span class="badge-dot"></span>
            <%= api.is_active ? 'Live' : 'Off' %>
          </span>
          <button class="api-msg-btn" onclick="openMsgModal(<%= api.id %>, '<%= encodeURIComponent(api.custom_message || '') %>')" title="Offline message">
            <i class="fa-solid fa-message-pen"></i>
          </button>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Empty state -->
    <div class="api-empty" id="apiEmpty" style="display:none">
      <i class="fa-solid fa-magnifying-glass"></i>
      <p>No endpoints match</p>
    </div>

  </div>

  <!-- Offline Message Modal -->
  <div class="modal-overlay" id="msgModal">
    <div class="modal" style="max-width:420px">
      <div class="modal-header">
        <div class="modal-title"><i class="fa-solid fa-message-pen"></i> Offline Message</div>
        <button class="modal-close" onclick="closeModal('msgModal')"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Message shown when endpoint is offline</label>
          <textarea id="msgModalText" rows="3" class="form-input" style="resize:vertical" placeholder="API is currently turned off."></textarea>
        </div>
        <input type="hidden" id="msgModalId">
        <button class="btn-primary" style="width:100%;justify-content:center" onclick="saveMsgModal()">
          <i class="fa-solid fa-floppy-disk"></i> Save Message
        </button>
      </div>
    </div>
  </div>


</main>

<!-- ── GENERATE MODAL ─────────────────────────────────── -->
<div id="generateModal" class="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title"><i class="fa-solid fa-key"></i> Generate API Key</div>
      <button class="modal-close" onclick="closeModal('generateModal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body">
      <form action="/admin/generate-key" method="POST">
        <div class="form-group">
          <label class="form-label">Client Name</label>
          <input type="text" name="name" required placeholder="e.g. Premium Client" class="form-input">
        </div>
        <div class="form-section">
          <div class="form-section-label">Custom Key</div>
          <div class="toggle-row" style="margin-bottom:10px">
            <label>Enable custom key string</label>
            <input type="checkbox" id="enable_custom" name="enable_custom" onchange="document.getElementById('custom_key_input').disabled=!this.checked">
          </div>
          <input type="text" id="custom_key_input" name="custom_key" disabled placeholder="SAHIL_VIP_KEY" class="form-input" style="opacity:0.4">
        </div>
        <div class="form-group">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
            <label class="form-label" style="margin-bottom:0">API Access</label>
            <div class="seg-toggle">
              <button type="button" class="seg-btn active" data-mode="all" onclick="setAccessMode('gen','all')">All</button>
              <button type="button" class="seg-btn" data-mode="single" onclick="setAccessMode('gen','single')">Single</button>
