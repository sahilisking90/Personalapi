<!-- ── TOAST ──────────────────────────────────────────── -->
<div class="toast" id="toast">
  <i class="fa-solid fa-check"></i>
  <span id="toastMsg">Copied!</span>
</div>

<script>
var dailyVolumeData  = <%- JSON.stringify(dailyVolume  || []) %>;
var topEndpointsData = <%- JSON.stringify(topEndpoints || []) %>;

// Charts
new Chart(document.getElementById('dailyChart'), {
  type: 'line',
  data: {
    labels: dailyVolumeData.map(function(d){ return d.date; }),
    datasets: [{
      data: dailyVolumeData.map(function(d){ return d.total; }),
      borderColor: '#22d3ee',
      backgroundColor: 'rgba(34,211,238,0.05)',
      tension: 0.4, fill: true,
      pointRadius: 3,
      pointBackgroundColor: '#22d3ee',
      pointBorderColor: '#050810',
      pointBorderWidth: 2,
      borderWidth: 2
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: {
      backgroundColor: '#0d1426', borderColor: 'rgba(255,255,255,0.08)',
      borderWidth: 1, titleColor: '#94a3b8', bodyColor: '#22d3ee',
      titleFont: { family: 'JetBrains Mono', size: 10 },
      bodyFont: { family: 'JetBrains Mono', size: 12 }
    }},
    scales: {
      x: { ticks: { color: '#334155', font: { size: 9, family: 'JetBrains Mono' }}, grid: { color: 'rgba(255,255,255,0.025)' }, border: { display: false }},
      y: { ticks: { color: '#334155', font: { size: 9, family: 'JetBrains Mono' }}, grid: { color: 'rgba(255,255,255,0.025)' }, border: { display: false }}
    }
  }
});

new Chart(document.getElementById('endpointsChart'), {
  type: 'doughnut',
  data: {
    labels: topEndpointsData.map(function(d){ return d.endpoint; }),
    datasets: [{
      data: topEndpointsData.map(function(d){ return d.hits; }),
      backgroundColor: ['rgba(34,211,238,0.7)','rgba(129,140,248,0.7)','rgba(52,211,153,0.7)','rgba(251,191,36,0.7)','rgba(248,113,113,0.7)'],
      borderWidth: 0, hoverOffset: 4
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    cutout: '65%',
    plugins: {
      legend: {
        display: true, position: 'right',
        labels: { color: '#475569', font: { size: 9, family: 'JetBrains Mono' }, padding: 10, boxWidth: 8, boxHeight: 8 }
      },
      tooltip: {
        backgroundColor: '#0d1426', borderColor: 'rgba(255,255,255,0.08)', borderWidth: 1,
        titleColor: '#94a3b8', bodyColor: '#22d3ee',
        titleFont: { family: 'JetBrains Mono', size: 10 }, bodyFont: { family: 'JetBrains Mono', size: 11 }
      }
    }
  }
});

// Modals
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(function(el) {
  el.addEventListener('click', function(e) { if(e.target === el) el.classList.remove('open'); });
});

// Expiry toggle
function toggleCustomExpiry(v) {
  var c = document.getElementById('customExpiryContainer');
  v === 'custom' ? c.classList.remove('hidden') : c.classList.add('hidden');
}

// Copy key
function copyKey(text) {
  navigator.clipboard.writeText(text).then(function() {
    var t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = 'Key copied!';
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 2200);
  });
}

// Filter
function filterKeys() {
  var val = document.getElementById('searchInput').value.toUpperCase();
  document.getElementById('keysTable').querySelectorAll('tbody tr').forEach(function(tr) {
    tr.style.display = tr.textContent.toUpperCase().includes(val) ? '' : 'none';
  });
}

// Edit modal
// ── ACCESS MODE TOGGLE ──
// Only the active mode's inputs stay enabled — disabled inputs don't submit,
// so exactly one "selected_apis" source reaches the backend.
function setAccessMode(scope, mode) {
  var allBox    = document.getElementById(scope === 'gen' ? 'gen-all-box'    : 'edit-all-box');
  var singleBox = document.getElementById(scope === 'gen' ? 'gen-single-box' : 'edit-single-box');
  var multiBox  = document.getElementById(scope === 'gen' ? 'gen-multi-box'  : 'edit-multi-box');
  var allInput  = document.getElementById(scope === 'gen' ? 'gen-all-input'  : 'edit-all-input');

  // hide all
  allBox.classList.add('hidden');
  singleBox.classList.add('hidden');
  multiBox.classList.add('hidden');

  // disable all inputs
  allInput.disabled = true;
  singleBox.disabled = true;
  multiBox.querySelectorAll('input').forEach(function(c){ c.disabled = true; });

  // enable + show selected
  if (mode === 'all') {
    allBox.classList.remove('hidden');
    allInput.disabled = false;
  } else if (mode === 'single') {
    singleBox.classList.remove('hidden');
    singleBox.disabled = false;
  } else if (mode === 'multi') {
    multiBox.classList.remove('hidden');
    multiBox.querySelectorAll('input').forEach(function(c){ c.disabled = false; });
  }

  // toggle button active state
  var container = scope === 'gen' ? document.getElementById('generateModal') : document.getElementById('editModal');
  container.querySelectorAll('.seg-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.mode === mode);
  });
}

function openEditModal(btn) {
  var d = btn.dataset;
  document.getElementById('edit_key_id').value = d.id;
  document.getElementById('edit_name').value = decodeURIComponent(d.name || '');
  document.getElementById('edit_api_enabled').value = d.enabled !== undefined ? d.enabled : 1;
  document.getElementById('edit_unlimited_hits').value = d.unlimited === '1' ? 'true' : 'false';
  document.getElementById('edit_rate_limit_per_day').value = d.rlDay || 100;
  document.getElementById('edit_rate_limit_per_minute').value = d.rlMin || 0;
  document.getElementById('edit_key_note').value = decodeURIComponent(d.note || '');

  // Determine access mode from saved allowed_apis
  var allowed = ['all'];
  try { allowed = JSON.parse(decodeURIComponent(d.allowed || '["all"]')); } catch(e) { allowed = ['all']; }

  if (!Array.isArray(allowed) || allowed.includes('all') || allowed.length === 0) {
    setAccessMode('edit', 'all');
  } else if (allowed.length === 1) {
    setAccessMode('edit', 'single');
    document.getElementById('edit-single-box').value = allowed[0];
  } else {
    setAccessMode('edit', 'multi');
    document.getElementById('edit-multi-box').querySelectorAll('input').forEach(function(c){
      c.checked = allowed.indexOf(c.value) >= 0;
    });
  }

  openModal('editModal');
}

async function submitEditKey(e) {
  e.preventDefault();
  var form = document.getElementById('editKeyForm');
  var fd = new FormData(form);
  // FormData handles multi-value selected_apis correctly via getAll
  var data = {};
  fd.forEach(function(value, key) {
    if (key === 'selected_apis') {
      if (!data.selected_apis) data.selected_apis = [];
      data.selected_apis.push(value);
    } else {
      data[key] = value;
    }
  });
  // flatten single-value selected_apis
  if (data.selected_apis && data.selected_apis.length === 1) data.selected_apis = data.selected_apis[0];

  var res = await fetch('/admin/edit-key', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  var result = await res.json();
  if(result.success) {
    document.getElementById('toastMsg').textContent = 'Key updated!';
    var t = document.getElementById('toast');
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); window.location.reload(); }, 1200);
  } else {
    alert('Error: ' + (result.error || 'Failed'));
  }
}

// Enable custom key input when checkbox enabled
document.getElementById('enable_custom').addEventListener('change', function() {
  var inp = document.getElementById('custom_key_input');
  inp.disabled = !this.checked;
  inp.style.opacity = this.checked ? '1' : '0.4';
});

// Init default access mode = All for both modals
setAccessMode('gen', 'all');

// ── API MANAGEMENT ─────────────────────────────────────────

function filterApis() {
  var val = document.getElementById('apiSearchInput').value.toLowerCase();
  var activeFilter = document.querySelector('.api-filter-btn.active')?.dataset.filter || 'all';
  var cards = document.querySelectorAll('.api-card-item');
  var visible = 0;
  cards.forEach(function(card) {
    var nameMatch = card.dataset.name.includes(val);
    var statusMatch = activeFilter === 'all' || card.dataset.status === activeFilter;
    if (nameMatch && statusMatch) { card.style.display = ''; visible++; }
    else card.style.display = 'none';
  });
  document.getElementById('apiEmpty').style.display = visible === 0 ? 'block' : 'none';
}

function filterByStatus(status, btn) {
  document.querySelectorAll('.api-filter-btn').forEach(function(b){ b.classList.remove('active'); b.dataset.filter = b.dataset.filter; });
  document.querySelectorAll('.api-filter-btn').forEach(function(b, i){ b.dataset.filter = ['all','on','off'][i]; });
  btn.classList.add('active');
  btn.dataset.filter = status;
  filterApis();
}

async function toggleApi(id, enabled, name) {
  var card = document.getElementById('apicard-' + id);
  card.classList.add('updating');
  try {
    var res = await fetch('/admin/toggle-api', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ api_id: id, is_active: enabled ? 1 : 0 })
    });
    var data = await res.json();
    if (data.success) {
      card.classList.toggle('is-on', enabled);
      card.classList.toggle('is-off', !enabled);
      card.dataset.status = enabled ? 'on' : 'off';
      // update badge
      var badge = card.querySelector('.api-status-badge');
      if (badge) {
        badge.className = 'api-status-badge ' + (enabled ? 'badge-live' : 'badge-dead');
        badge.innerHTML = '<span class="badge-dot"></span>' + (enabled ? 'Live' : 'Off');
      }
      // update counts
      var online  = document.querySelectorAll('.api-card-item.is-on').length;
      var offline = document.querySelectorAll('.api-card-item.is-off').length;
      document.getElementById('apiOnlineCount').textContent  = online;
      document.getElementById('apiOfflineCount').textContent = offline;
      showToast(name + ' ' + (enabled ? 'enabled' : 'disabled'));
    } else {
      document.getElementById('toggle-' + id).checked = !enabled;
      showToast('Failed to update', true);
    }
  } catch(e) {
    document.getElementById('toggle-' + id).checked = !enabled;
    showToast('Network error', true);
  }
  card.classList.remove('updating');
}

async function bulkToggle(enabled) {
  var cards = document.querySelectorAll('.api-card-item');
  var promises = [];
  cards.forEach(function(card) {
    var id = card.dataset.id;
    var chk = document.getElementById('toggle-' + id);
    if (chk && chk.checked !== enabled) {
      promises.push(toggleApi(id, enabled, card.querySelector('.api-card-name')?.textContent || 'API'));
    }
  });
  await Promise.all(promises);
  showToast(enabled ? 'All endpoints enabled' : 'All endpoints disabled');
}

function openMsgModal(id, encodedMsg) {
  document.getElementById('msgModalId').value = id;
  document.getElementById('msgModalText').value = decodeURIComponent(encodedMsg) || 'API is currently turned off.';
  openModal('msgModal');
}

async function saveMsgModal() {
  var id  = document.getElementById('msgModalId').value;
  var msg = document.getElementById('msgModalText').value.trim() || 'API is currently turned off.';
  var card = document.getElementById('apicard-' + id);
  var isActive = card ? (card.dataset.status === 'on' ? 1 : 0) : 0;
  try {
    var res = await fetch('/admin/update-api-status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ api_id: id, is_active: isActive, custom_message: msg })
    });
    var data = await res.json();
    if (data.success) {
      closeModal('msgModal');
      showToast('Offline message saved');
    } else {
      showToast('Save failed', true);
    }
  } catch(e) { showToast('Network error', true); }
}

// Init filter data attributes on load
document.querySelectorAll('.api-filter-btn').forEach(function(b, i) {
  b.dataset.filter = ['all','on','off'][i];
});

function showToast(msg, err) {
  var t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.style.background = err ? 'rgba(248,113,113,0.15)' : '';
  t.style.borderColor = err ? 'rgba(248,113,113,0.3)' : '';
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); t.style.background=''; t.style.borderColor=''; }, 2200);
}

</script>
</body>
</html>
