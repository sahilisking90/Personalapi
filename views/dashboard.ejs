        </div>
        <div id="customExpiryContainer" class="form-grid-2 hidden" style="margin-bottom:16px">
          <div>
            <label class="form-label">Date</label>
            <input type="date" name="custom_expiry_date" class="form-input">
          </div>
          <div>
            <label class="form-label">Time</label>
            <input type="time" name="custom_expiry_time" value="23:59" class="form-input">
