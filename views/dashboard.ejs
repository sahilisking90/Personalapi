          <!-- SINGLE mode -->
          <select id="gen-single-box" name="selected_apis" class="form-select hidden" disabled>
            <% apis.forEach(function(api){%><option value="<%= api.name %>"><%= api.display_name %></option><%});%>
          </select>

          <!-- MULTI mode -->
          <div id="gen-multi-box" class="checkbox-grid hidden">
            <% apis.forEach(function(api){%>
              <label class="check-item">
                <input type="checkbox" name="selected_apis" value="<%= api.name %>" disabled>
                <span><%= api.display_name %></span>
